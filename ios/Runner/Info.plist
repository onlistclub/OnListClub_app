<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>OnListClub</string>
		<key>CFBundleDisplayName</key>
		<string>OnListClub</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<!-- Solo "mentre usi l'app": LocationService chiama
		     Geolocator.requestPermission(), che su iOS chiede When In Use e
		     nient'altro. `always` viene accettato se l'utente lo concede da
		     Impostazioni, ma non lo chiediamo mai e non c'è niente che giri in
		     background.
		     NSLocationAlwaysAndWhenInUseUsageDescription era dichiarata qui:
		     rimossa. Dichiarare la posizione in background senza usarla fa
		     scattare in App Review la domanda "dov'è la funzionalità?", che
		     senza una risposta diventa un rifiuto. Va rimessa solo il giorno in
		     cui servirà davvero il tracciamento a schermo spento. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>La tua posizione viene usata per mostrarti eventi e persone vicino a te.</string>
		<!-- Foto profilo (schermata Account): image_picker apre la libreria
		     foto. Senza questa chiave iOS chiude l'app al primo accesso e
		     App Review rifiuta la build. La fotocamera NON viene usata
		     (ImageSource.gallery), quindi niente NSCameraUsageDescription:
		     va aggiunta solo se in futuro si offre lo scatto diretto. -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Scegli una foto dalla tua libreria per impostarla come immagine del profilo.</string>
		<!-- Export compliance: l'app usa solo HTTPS/TLS standard di sistema
		     (Supabase, Brevo via edge function) e nessuna crittografia
		     proprietaria, quindi rientra nelle esenzioni. Dichiararlo qui evita
		     che App Store Connect fermi OGNI upload con la domanda
		     sull'export compliance, da rispondere a mano ogni volta.
		     Se un giorno l'app implementasse cifratura propria, questa chiave
		     va rivista: la dichiarazione è vincolante. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- Status bar chiara su tutta l'app (sfondi dark).
		     UIViewControllerBasedStatusBarAppearance=YES: lo stile lo controlla
		     Flutter (SystemChrome / AnnotatedRegion con statusBarBrightness.dark
		     -> icone bianche), unica fonte di verita' cross-platform. Con NO iOS
		     ignorava il controllo di Flutter e le icone restavano scure.
		     UIStatusBarStyle qui sotto e' solo il fallback per l'istante di lancio
		     nativo (pre-Flutter); a runtime prevale la scelta di Flutter. -->
		<key>UIStatusBarStyle</key>
		<string>UIStatusBarStyleLightContent</string>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<true/>
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
		</dict>
		<!-- Google Sign-In: iOS Client ID + URL scheme inverso per il redirect OAuth.
	     Senza il CFBundleURLTypes il login Google nativo crasha/non torna all'app. -->
		<key>GIDClientID</key>
		<string>73394688512-kt2hojans7apksgvu1rs3d72ofmgistd.apps.googleusercontent.com</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.73394688512-kt2hojans7apksgvu1rs3d72ofmgistd</string>
				</array>
			</dict>
			<!-- Custom scheme dell'app: usato per i deep link di ritorno dal sito
		     (es. /auth/email-confirmed, /auth/password-changed) e da Stripe
		     (vedi docs/database/stripe_integration_plan.md). -->
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.onlistclub.app</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>onlistclub</string>
				</array>
			</dict>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
